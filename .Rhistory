library(tidyverse)
library(knitr)
yrbss_clean <- yrbss |>
mutate(
indicator = case_when(
str_detect(Question, "sad or hopeless") ~
"Persistent sadness or hopelessness",
str_detect(Question, "seriously consider") ~
"Seriously considered suicide",
str_detect(Question, "make a plan") ~
"Made a suicide plan",
str_detect(Question, "actually attempt") ~
"Attempted suicide",
str_detect(Question, "mental health not good") ~
"Poor mental health",
str_detect(Question, "prescription pain medicine") ~
"Prescription pain medicine misuse",
str_detect(Question, "select illicit drugs") ~
"Illicit drug use"
)
)
