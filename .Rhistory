library(gtsummary)
table1 <- yrbss_clean |>
filter(
Year == 2023,
Area == "United States",
Demographics_Type == "Sex",
)
table_one <- table1 |>
select(Demographics_Value, Percent) |>
tbl_summary(by = Demographics_Value)
table_one
table1 <- yrbss_clean |>
filter(
Year == 2023,
Area == "United States",
Demographics_Type == "Sex",
)
table_one <- table1 |>
select(Demographics_Value) |>
tbl_summary(by = Demographics_Value)
figure_data <- yrbss_clean |>
filter(
Area == "United States",
Demographics_Type == "Sex",
Demographics_Value %in% c("Female", "Male"),
indicator == "Persistent sadness or hopelessness"
)
ggplot(
figure_data,
aes(
x = Year,
y = Percent,
group = Demographics_Value,
linetype = Demographics_Value,
shape = Demographics_Value
)
) +
geom_line(linewidth = 1) +
geom_point(size = 3) +
geom_errorbar(
aes(
ymin = Low_Confidence_Interval,
ymax = High_Confidence_Interval
),
width = 0.1
) +
scale_x_continuous(
breaks = c(2019, 2021, 2023)
) +
labs(
title = "Persistent Sadness or Hopelessness Among U.S. High School Students",
subtitle = "Youth Risk Behavior Surveillance System, 2019–2023",
x = "Year",
y = "Percent of students (%)",
linetype = "Sex",
shape = "Sex"
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "bottom"
)
